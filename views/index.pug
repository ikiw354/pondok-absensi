html(lang="id")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Portal Absensi Pondok Pesantren
    
    // Bootstrap 5 CDN
    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )
    // Google Font: Plus Jakarta Sans
    link(
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    )

    style.
      :root {
        --primary-color: #0f766e;
        --primary-dark: #1e293b;
        --accent-color: #0d6efd;
        --bg-color: #f8fafc;
        --card-border: #e2e8f0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--bg-color);
        color: #334155;
      }

      .header-banner {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
        padding: 40px 30px;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(15, 118, 110, 0.2);
        position: relative;
        overflow: hidden;
      }

      .header-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        pointer-events: none;
      }

      .nav-pills .nav-link {
        color: #64748b;
        font-weight: 600;
        padding: 12px 20px;
        border-radius: 10px;
        transition: all 0.3s ease;
        border: 1px solid transparent;
      }

      .nav-pills .nav-link:hover {
        background-color: #f1f5f9;
        color: var(--primary-color);
      }

      .nav-pills .nav-link.active {
        background-color: var(--primary-color);
        color: white;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.25);
      }

      .card-premium {
        border: 1px solid var(--card-border);
        border-radius: 20px;
        background: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .card-premium:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
      }

      .table-premium {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
      }

      .table-premium thead {
        background-color: var(--primary-dark);
        color: white;
      }

      .table-premium th {
        font-weight: 600;
        padding: 15px;
        font-size: 14px;
      }

      .table-premium td {
        padding: 14px 15px;
        font-size: 14px;
        vertical-align: middle;
      }

      .table-hover tbody tr:hover {
        background-color: #f8fafc;
      }

      .badge-hadir { background-color: #dcfce7; color: #16a34a; font-weight: 700; border: 1px solid #bbf7d0; }
      .badge-izin { background-color: #fef3c7; color: #d97706; font-weight: 700; border: 1px solid #fde68a; }
      .badge-sakit { background-color: #dbeafe; color: #2563eb; font-weight: 700; border: 1px solid #bfdbfe; }
      .badge-alfa { background-color: #fee2e2; color: #dc2626; font-weight: 700; border: 1px solid #fecaca; }

      .btn-primary-custom {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s ease;
      }

      .btn-primary-custom:hover {
        background-color: #0d5c56;
        border-color: #0d5c56;
        color: white;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.2);
      }

      .btn-dark-custom {
        background-color: var(--primary-dark);
        border-color: var(--primary-dark);
        color: white;
        font-weight: 600;
        border-radius: 10px;
      }

      .btn-dark-custom:hover {
        background-color: #0f172a;
        color: white;
      }

      /* Form inputs customization */
      .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 10px 14px;
        font-size: 14px;
        transition: all 0.2s ease;
      }

      .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
      }

      .toast-container-custom {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 1100;
      }

      /* Float button effect */
      .action-btn-group .btn {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
      }

  body
    // ================= TOAST CONTAINER =================
    #toastContainer.toast-container-custom.position-fixed.bottom-0.end-0.p-3

    .container.py-5

      // ================= HEADER =================
      .header-banner.mb-4.text-center
        h1.mb-1.fw-extrabold Portal Absensi Santri Pondok Schooling Darul Ilmi
        p.mb-3.opacity-75 Laporan & Pengelolaan Data Kehadiran Pondok Pesantren
        div.d-flex.justify-content-center.gap-2
          a.btn.btn-danger.px-4.py-2.fw-bold.shadow-sm(href="/laporan/mingguan")
            | 📥 Unduh Laporan PDF (7 Hari Terakhir)

      // ================= NAVIGATION TAB =================
      .card-premium.p-3.mb-4
        ul#tabsAbsensi.nav.nav-pills.nav-fill.gap-2(role="tablist")
          li.nav-item(role="presentation")
            button#tab-absen.nav-link.active(
              data-bs-toggle="pill"
              data-bs-target="#panel-absen"
              type="button"
              role="tab"
            ) 📋 Catat Absensi
          li.nav-item(role="presentation")
            button#tab-riwayat.nav-link(
              data-bs-toggle="pill"
              data-bs-target="#panel-riwayat"
              type="button"
              role="tab"
            ) 📅 Riwayat Absen
          li.nav-item(role="presentation")
            button#tab-santri.nav-link(
              data-bs-toggle="pill"
              data-bs-target="#panel-santri"
              type="button"
              role="tab"
            ) 👥 Kelola Santri
          li.nav-item(role="presentation")
            button#tab-kegiatan.nav-link(
              data-bs-toggle="pill"
              data-bs-target="#panel-kegiatan"
              type="button"
              role="tab"
            ) 🎯 Kelola Kegiatan

      // ================= TAB CONTENT =================
      .tab-content
        
        // ---------------- TAB 1: ABSENSI MASSAL ----------------
        #panel-absen.tab-pane.fade.show.active(role="tabpanel")
          .card-premium.p-4
            h4.mb-3.fw-bold 📋 Catat Absensi Harian Santri
            p.text-muted.small Masukkan daftar absensi seluruh santri berdasarkan kegiatan terpilih.

            form#formAbsenMassal(action="/absen/massal" method="POST")
              .mb-4
                label.form-label.fw-bold Pilih Kegiatan
                select.form-select.form-select-lg(name="kegiatan_id" required)
                  option(value="") -- Pilih Kegiatan --
                  each k in kegiatan
                    option(value=k.id)= k.nama

              .table-responsive.mt-3
                table.table.table-hover.align-middle.table-premium
                  thead
                    tr
                      th(width="50") No
                      th Nama Santri
                      th.text-center(width="250") Status Kehadiran
                  tbody
                    if santri.length > 0
                      each s, idx in santri
                        tr
                          td.text-muted.small= idx + 1
                          td.fw-bold= s.nama
                          td
                            select.form-select(name=`status_${s.id}`)
                              option(value="Hadir") 🟢 Hadir
                              option(value="Izin") 🟡 Izin
                              option(value="Sakit") 🔵 Sakit
                              option(value="Alfa") 🔴 Alfa
                    else
                      tr
                        td.text-center(colspan="3") 
                          span.text-muted Belum ada data santri. Silakan tambah santri terlebih dahulu di tab 'Kelola Santri'.

              if santri.length > 0
                button.btn.btn-primary-custom.w-100.mt-4.py-2.fs-6(type="submit")
                  | 💾 Simpan Semua Kehadiran

        // ---------------- TAB 2: RIWAYAT ABSENSI ----------------
        #panel-riwayat.tab-pane.fade(role="tabpanel")
          .card-premium.p-4
            h4.mb-3.fw-bold 📅 Riwayat & Filter Kehadiran
            
            // Filter Form
            form(method="GET" action="/").mb-4
              .row.g-3.align-items-end
                .col-md-4
                  label.form-label.fw-semibold Pilih Tanggal
                  input.form-control(
                    type="date"
                    name="tanggal"
                    value=tanggal
                  )
                .col-md-2
                  button.btn.btn-dark-custom.w-100(type="submit" style="padding: 10.5px;")
                    | 🔍 Filter Data
                .col-md-6
                  label.form-label.fw-semibold Cari Riwayat
                  input#searchRiwayat.form-control(
                    type="text"
                    placeholder="Ketik nama santri atau kegiatan..."
                  )

            .table-responsive
              table#tableRiwayat.table.table-hover.align-middle.table-premium
                thead
                  tr
                    th(width="50") No
                    th Nama Santri
                    th Kegiatan
                    th.text-center Status
                    th Tanggal
                    th.text-center(width="180") Aksi
                tbody
                  if absensi.length > 0
                    each a, idx in absensi
                      tr
                        td.text-muted.small= idx + 1
                        td.fw-bold= a.santri
                        td= a.kegiatan
                        td.text-center
                          if a.status == 'Hadir'
                            span.badge.badge-hadir.px-3.py-2 🟢 Hadir
                          else if a.status == 'Izin'
                            span.badge.badge-izin.px-3.py-2 🟡 Izin
                          else if a.status == 'Sakit'
                            span.badge.badge-sakit.px-3.py-2 🔵 Sakit
                          else
                            span.badge.badge-alfa.px-3.py-2 🔴 Alfa
                        
                        td= new Date(a.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                        td.text-center.action-btn-group
                          button.btn.btn-warning.btn-sm.me-1(
                            type="button"
                            onclick= "openEditAbsenModal(" + a.id + ", '" + a.santri.replace(/'/g, "\\'") + "', '" + a.status + "', " + a.kegiatan_id + ", '" + new Date(a.tanggal).toLocaleDateString('en-CA') + "')"
                          ) 📝 Edit
                          button.btn.btn-danger.btn-sm(
                            type="button"
                            onclick= "deleteAbsen(" + a.id + ")"
                          ) 🗑️ Hapus
                  else
                    tr
                      td.text-center(colspan="6")
                        span.text-muted Tidak ada data absensi untuk tanggal ini.

        // ---------------- TAB 3: KELOLA SANTRI ----------------
        #panel-santri.tab-pane.fade(role="tabpanel")
          .row.g-4
            // Form Add
            .col-lg-4
              .card-premium.p-4
                h4.mb-3.fw-bold ➕ Tambah Santri Baru
                form#formAddSantri
                  .mb-3
                    label.form-label Nama Lengkap Santri
                    input.form-control(
                      type="text"
                      name="nama"
                      placeholder="Masukkan nama santri..."
                      required
                    )
                  button.btn.btn-primary-custom.w-100(type="submit")
                    | Simpan Santri

            // Table List
            .col-lg-8
              .card-premium.p-4
                .d-flex.justify-content-between.align-items-center.mb-3
                  h4.fw-bold.mb-0 👥 Daftar Santri
                  input#searchSantri.form-control.w-50(
                    type="text"
                    placeholder="Cari nama santri..."
                  )
                
                .table-responsive
                  table#tableSantri.table.table-hover.align-middle.table-premium
                    thead
                      tr
                        th(width="60") No
                        th Nama Santri
                        th.text-center(width="180") Aksi
                    tbody
                      if santri.length > 0
                        each s, idx in santri
                          tr
                            td.text-muted.small= idx + 1
                            td.fw-bold= s.nama
                            td.text-center.action-btn-group
                              button.btn.btn-warning.btn-sm.me-1(
                                type="button"
                                onclick= "openEditSantriModal(" + s.id + ", '" + s.nama.replace(/'/g, "\\'") + "')"
                              ) 📝 Rename
                              button.btn.btn-danger.btn-sm(
                                type="button"
                                onclick= "deleteSantri(" + s.id + ", '" + s.nama.replace(/'/g, "\\'") + "')"
                              ) 🗑️ Hapus
                      else
                        tr
                          td.text-center(colspan="3")
                            span.text-muted Data santri kosong.

        // ---------------- TAB 4: KELOLA KEGIATAN ----------------
        #panel-kegiatan.tab-pane.fade(role="tabpanel")
          .row.g-4
            // Form Add
            .col-lg-4
              .card-premium.p-4
                h4.mb-3.fw-bold ➕ Tambah Kegiatan
                form#formAddKegiatan
                  .mb-3
                    label.form-label Nama Kegiatan
                    input.form-control(
                      type="text"
                      name="nama"
                      placeholder="Contoh: Kajian Hadits..."
                      required
                    )
                  button.btn.btn-primary-custom.w-100(type="submit")
                    | Simpan Kegiatan

            // Table List
            .col-lg-8
              .card-premium.p-4
                .d-flex.justify-content-between.align-items-center.mb-3
                  h4.fw-bold.mb-0 🎯 Daftar Kegiatan
                  input#searchKegiatan.form-control.w-50(
                    type="text"
                    placeholder="Cari nama kegiatan..."
                  )

                .table-responsive
                  table#tableKegiatan.table.table-hover.align-middle.table-premium
                    thead
                      tr
                        th(width="60") No
                        th Nama Kegiatan
                        th.text-center(width="180") Aksi
                    tbody
                      if kegiatan.length > 0
                        each k, idx in kegiatan
                          tr
                            td.text-muted.small= idx + 1
                            td.fw-bold= k.nama
                            td.text-center.action-btn-group
                              button.btn.btn-warning.btn-sm.me-1(
                                type="button"
                                onclick= "openEditKegiatanModal(" + k.id + ", '" + k.nama.replace(/'/g, "\\'") + "')"
                              ) 📝 Rename
                              button.btn.btn-danger.btn-sm(
                                type="button"
                                onclick= "deleteKegiatan(" + k.id + ", '" + k.nama.replace(/'/g, "\\'") + "')"
                              ) 🗑️ Hapus
                      else
                        tr
                          td.text-center(colspan="3")
                            span.text-muted Data kegiatan kosong.

    // ==========================================
    // MODALS FOR EDITING MASTER DATA & TRANSACTION
    // ==========================================
    
    // Modal Edit Santri
    #modalEditSantri.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content(style="border-radius: 16px; border: none;")
          .modal-header.bg-light(style="border-radius: 16px 16px 0 0;")
            h5.modal-title.fw-bold 📝 Ubah Nama Santri
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-4
            form#formEditSantri
              input#editSantriId(type="hidden")
              .mb-3
                label.form-label Nama Santri
                input#editSantriNama.form-control(type="text" required)
              button.btn.btn-primary-custom.w-100(type="submit") Simpan Perubahan

    // Modal Edit Kegiatan
    #modalEditKegiatan.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content(style="border-radius: 16px; border: none;")
          .modal-header.bg-light(style="border-radius: 16px 16px 0 0;")
            h5.modal-title.fw-bold 📝 Ubah Nama Kegiatan
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-4
            form#formEditKegiatan
              input#editKegiatanId(type="hidden")
              .mb-3
                label.form-label Nama Kegiatan
                input#editKegiatanNama.form-control(type="text" required)
              button.btn.btn-primary-custom.w-100(type="submit") Simpan Perubahan

    // Modal Edit Absensi Individual
    #modalEditAbsen.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content(style="border-radius: 16px; border: none;")
          .modal-header.bg-light(style="border-radius: 16px 16px 0 0;")
            h5.modal-title.fw-bold 📝 Ubah Data Absensi
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-4
            form#formEditAbsen
              input#editAbsenId(type="hidden")
              .mb-3
                label.form-label Nama Santri
                input#editAbsenSantri.form-control(type="text" readonly)
              .mb-3
                label.form-label Kegiatan
                select#editAbsenKegiatan.form-select(required)
                  each k in kegiatan
                    option(value=k.id)= k.nama
              .mb-3
                label.form-label Status Kehadiran
                select#editAbsenStatus.form-select(required)
                  option(value="Hadir") Hadir
                  option(value="Izin") Izin
                  option(value="Sakit") Sakit
                  option(value="Alfa") Alfa
              .mb-3
                label.form-label Tanggal
                input#editAbsenTanggal.form-control(type="date" required)
              button.btn.btn-primary-custom.w-100(type="submit") Simpan Absensi

    // Bootstrap JS Bundle
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")

    // JavaScript logic for AJAX & dynamic interactions
    script.
      document.addEventListener('DOMContentLoaded', () => {
        // Recover active tab on reload if stored
        const activeTab = localStorage.getItem('activeTab');
        if (activeTab) {
          const tabBtn = document.querySelector(`[data-bs-target="${activeTab}"]`);
          if (tabBtn) {
            bootstrap.Tab.getOrCreateInstance(tabBtn).show();
          }
        }

        // Save active tab in localStorage
        const tabElList = document.querySelectorAll('button[data-bs-toggle="pill"]');
        tabElList.forEach(tabEl => {
          tabEl.addEventListener('shown.bs.tab', (event) => {
            const target = event.target.getAttribute('data-bs-target');
            localStorage.setItem('activeTab', target);
          });
        });

        // Setup AJAX requests
        window.apiRequest = async (url, method, data = null) => {
          try {
            const options = {
              method: method,
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              }
            };
            if (data) {
              options.body = JSON.stringify(data);
            }
            const response = await fetch(url, options);
            const result = await response.json();
            if (!response.ok) {
              throw new Error(result.error || 'Terjadi kesalahan sistem');
            }
            return result;
          } catch (error) {
            showToast(error.message, 'danger');
            throw error;
          }
        };

        window.showToast = (message, type = 'success') => {
          const container = document.getElementById('toastContainer');
          const id = 'toast_' + Date.now();
          const bgClass = type === 'success' ? 'bg-success' : (type === 'danger' ? 'bg-danger' : 'bg-warning text-dark');
          const icon = type === 'success' ? '✅' : (type === 'danger' ? '❌' : '⚠️');

          const html = `
            <div id="${id}" class="toast align-items-center text-white ${bgClass} border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
              <div class="d-flex">
                <div class="toast-body fw-bold">
                  ${icon} ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
            </div>
          `;
          container.insertAdjacentHTML('beforeend', html);
          const el = document.getElementById(id);
          const bsToast = new bootstrap.Toast(el, { delay: 3000 });
          bsToast.show();
          el.addEventListener('hidden.bs.toast', () => el.remove());
        };

        // ================= CLIENT SEARCH FILTERS =================
        const setupFilter = (inputId, tableId) => {
          const input = document.getElementById(inputId);
          const table = document.getElementById(tableId);
          if (input && table) {
            input.addEventListener('input', (e) => {
              const q = e.target.value.toLowerCase();
              const rows = table.querySelectorAll('tbody tr');
              rows.forEach(r => {
                if (r.cells.length > 1) {
                  const text = r.innerText.toLowerCase();
                  r.style.display = text.includes(q) ? '' : 'none';
                }
              });
            });
          }
        };

        setupFilter('searchRiwayat', 'tableRiwayat');
        setupFilter('searchSantri', 'tableSantri');
        setupFilter('searchKegiatan', 'tableKegiatan');

        // ================= FORM SUBMISSIONS =================

        // 1. Absensi Massal
        const formAbsenMassal = document.getElementById('formAbsenMassal');
        if (formAbsenMassal) {
          formAbsenMassal.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(formAbsenMassal);
            const data = {};
            formData.forEach((value, key) => {
              data[key] = value;
            });

            try {
              const res = await apiRequest('/absen/massal', 'POST', data);
              showToast(res.message, 'success');
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          });
        }

        // 2. Tambah Santri
        const formAddSantri = document.getElementById('formAddSantri');
        if (formAddSantri) {
          formAddSantri.addEventListener('submit', async (e) => {
            e.preventDefault();
            const nama = formAddSantri.nama.value;
            try {
              const res = await apiRequest('/santri', 'POST', { nama });
              showToast(res.message, 'success');
              formAddSantri.reset();
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          });
        }

        // 3. Edit Santri
        const formEditSantri = document.getElementById('formEditSantri');
        const modalEditSantriEl = document.getElementById('modalEditSantri');
        const bsModalEditSantri = new bootstrap.Modal(modalEditSantriEl);

        window.openEditSantriModal = (id, nama) => {
          document.getElementById('editSantriId').value = id;
          document.getElementById('editSantriNama').value = nama;
          bsModalEditSantri.show();
        };

        formEditSantri.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = document.getElementById('editSantriId').value;
          const nama = document.getElementById('editSantriNama').value;
          try {
            const res = await apiRequest(`/santri/${id}`, 'PUT', { nama });
            showToast(res.message, 'success');
            bsModalEditSantri.hide();
            setTimeout(() => window.location.reload(), 1200);
          } catch (err) {}
        });

        // Hapus Santri
        window.deleteSantri = async (id, nama) => {
          if (confirm(`Apakah Anda yakin ingin menghapus santri "${nama}"?\nSemua riwayat absensinya juga akan ikut terhapus.`)) {
            try {
              const res = await apiRequest(`/santri/${id}`, 'DELETE');
              showToast(res.message, 'success');
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          }
        };

        // 4. Tambah Kegiatan
        const formAddKegiatan = document.getElementById('formAddKegiatan');
        if (formAddKegiatan) {
          formAddKegiatan.addEventListener('submit', async (e) => {
            e.preventDefault();
            const nama = formAddKegiatan.nama.value;
            try {
              const res = await apiRequest('/kegiatan', 'POST', { nama });
              showToast(res.message, 'success');
              formAddKegiatan.reset();
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          });
        }

        // 5. Edit Kegiatan
        const formEditKegiatan = document.getElementById('formEditKegiatan');
        const modalEditKegiatanEl = document.getElementById('modalEditKegiatan');
        const bsModalEditKegiatan = new bootstrap.Modal(modalEditKegiatanEl);

        window.openEditKegiatanModal = (id, nama) => {
          document.getElementById('editKegiatanId').value = id;
          document.getElementById('editKegiatanNama').value = nama;
          bsModalEditKegiatan.show();
        };

        formEditKegiatan.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = document.getElementById('editKegiatanId').value;
          const nama = document.getElementById('editKegiatanNama').value;
          try {
            const res = await apiRequest(`/kegiatan/${id}`, 'PUT', { nama });
            showToast(res.message, 'success');
            bsModalEditKegiatan.hide();
            setTimeout(() => window.location.reload(), 1200);
          } catch (err) {}
        });

        // Hapus Kegiatan
        window.deleteKegiatan = async (id, nama) => {
          if (confirm(`Apakah Anda yakin ingin menghapus kegiatan "${nama}"?\nSemua riwayat absensi terkait kegiatan ini juga akan ikut terhapus.`)) {
            try {
              const res = await apiRequest(`/kegiatan/${id}`, 'DELETE');
              showToast(res.message, 'success');
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          }
        };

        // 6. Edit Absensi
        const formEditAbsen = document.getElementById('formEditAbsen');
        const modalEditAbsenEl = document.getElementById('modalEditAbsen');
        const bsModalEditAbsen = new bootstrap.Modal(modalEditAbsenEl);

        window.openEditAbsenModal = (id, santriNama, status, kegiatanId, tanggal) => {
          document.getElementById('editAbsenId').value = id;
          document.getElementById('editAbsenSantri').value = santriNama;
          document.getElementById('editAbsenStatus').value = status;
          if (kegiatanId) {
            document.getElementById('editAbsenKegiatan').value = kegiatanId;
          }
          document.getElementById('editAbsenTanggal').value = tanggal;
          bsModalEditAbsen.show();
        };

        formEditAbsen.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = document.getElementById('editAbsenId').value;
          const status = document.getElementById('editAbsenStatus').value;
          const kegiatan_id = document.getElementById('editAbsenKegiatan').value;
          const tanggal = document.getElementById('editAbsenTanggal').value;

          try {
            const res = await apiRequest(`/absen/${id}`, 'PUT', { status, kegiatan_id, tanggal });
            showToast(res.message, 'success');
            bsModalEditAbsen.hide();
            setTimeout(() => window.location.reload(), 1200);
          } catch (err) {}
        });

        // Hapus Absensi Individual
        window.deleteAbsen = async (id) => {
          if (confirm('Apakah Anda yakin ingin menghapus catatan absensi ini?')) {
            try {
              const res = await apiRequest(`/absen/${id}`, 'DELETE');
              showToast(res.message, 'success');
              setTimeout(() => window.location.reload(), 1200);
            } catch (err) {}
          }
        };

      });